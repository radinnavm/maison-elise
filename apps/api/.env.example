# Server
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maison_elise

# Authentication
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=maison_elise_token
COOKIE_MAX_AGE_DAYS=7
# lax (default) | strict | none (none requires HTTPS)
COOKIE_SAME_SITE=lax

# Frontend origin(s) allowed to send credentialed requests (comma-separated).
CLIENT_URL=http://localhost:5173
# Optional separate admin origin (also allowed by CORS).
ADMIN_URL=

# Public base URL used to build absolute image URLs
API_PUBLIC_URL=http://localhost:4000

# Trust proxy: false (default), a hop count (e.g. 1), or a subnet/name list
# (e.g. loopback). Required to read the real client IP behind a load balancer.
TRUST_PROXY=false

# Logging and request limits
LOG_LEVEL=debug
JSON_BODY_LIMIT=1mb

# Rate limiting. Disabled automatically when NODE_ENV=test unless explicitly enabled.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
PAYMENT_RATE_LIMIT_MAX=30
PAYMENT_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX=120
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
ADMIN_RATE_LIMIT_MAX=300
ADMIN_RATE_LIMIT_WINDOW_MS=60000

# Origin/Referer validation for cookie-authenticated state-changing requests
# (CSRF defence-in-depth). Disabled automatically when NODE_ENV=test.
CSRF_PROTECTION_ENABLED=true

# Re-send transactional emails stuck PENDING after an interrupted process
# (`pnpm --filter @maison-elise/api email:recover`). Default 15 minutes.
EMAIL_PENDING_RECOVERY_MS=900000

# Stripe (Test Mode). Never commit real keys. The secret key and webhook secret
# are backend-only and must never be exposed to the client.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (Resend). When EMAIL_PROVIDER_API_KEY is empty the API uses
# the development logging provider instead of sending real emails.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=Maison Élise <no-reply@maisonelise.com>
EMAIL_REPLY_TO=
# Public storefront URL used to build links inside transactional emails.
APP_URL=http://localhost:5173

# Seed credentials (development only). If omitted, the seed generates random passwords.
ADMIN_EMAIL=admin@maisonelise.com
ADMIN_PASSWORD=change-me-admin-password
CUSTOMER_EMAIL=customer@maisonelise.com
CUSTOMER_PASSWORD=change-me-customer-password
