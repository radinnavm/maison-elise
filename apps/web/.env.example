# Base URL for the API. In development this is proxied by Vite to http://localhost:4000.
# Use an absolute URL (e.g. https://api.example.com/api/v1) when calling the API directly.
VITE_API_URL=/api/v1

# Stripe publishable key (Test Mode). Safe to expose to the browser; never put the
# Stripe secret key here.
VITE_STRIPE_PUBLISHABLE_KEY=

# Absolute public origin of the storefront, used for canonical and Open Graph URLs.
# Example: https://www.maison-elise.com
VITE_SITE_URL=

# Set to "false" on staging/preview deployments to force noindex everywhere.
# Defaults to indexable public pages in production.
VITE_ALLOW_INDEXING=true

# Serve the local, database-independent demo catalog (60 products, local images).
# Enabled by default; set to "false" to use the API/database catalog instead.
VITE_DEMO_CATALOG=true
